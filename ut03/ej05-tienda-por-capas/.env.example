# Copia este fichero a .env y pon tu clave. .env no se sube a Git.
# Lo usan a la vez docker compose (contenedor MySQL) y App.java (conexión): una sola clave.
# Los tests usan H2 en memoria y no necesitan nada de esto.
DB_URL=jdbc:mysql://localhost:3307/tienda
DB_USER=dwes
# Pon una clave cualquiera usando solo letras, números, guion (-) y guion bajo (_).
# Con $, espacios o comillas simples, docker compose y "source .env" leen una clave distinta o fallan.
# Usar la misma clave para el usuario y para el administrador solo vale en un contenedor local:
# en producción, claves distintas y usuarios con los mínimos permisos.
# Escribe tu clave justo después del «=». Es obligatoria: si queda vacía, docker compose no arranca.
DB_PASSWORD=
# Si cambias el puerto, cámbialo también en DB_URL.
DB_PORT=3307
# Qué implementación del DAO usa App: jdbc (MySQL real) o memoria (sin base de datos)
DAO_MODO=jdbc
